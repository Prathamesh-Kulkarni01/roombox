/**
 * FIRESTORE RULES
 * Changes: 
 * - Fixed permission errors by adjusting rules for collection-level queries.
 * - Separated 'list' operations from 'get' operations.
 * - Removed unused 'isOwner' helper function.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────

    // True if the requesting user is logged-in
    function isAuth() {
      return request.auth != null;
    }


    // True if the user has a staff token that includes this PG
    function isStaff(pgId) {
      return isAuth() && request.auth.token.pgs != null && pgId in request.auth.token.pgs;
    }

    // New helper for granular permissions (supports flat array format)
    function hasPermission(feature, action) {
      let perm = feature + ":" + action;
      return isAuth() && request.auth.token.permissions != null && perm in request.auth.token.permissions;
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      
      // Allow initial skeleton creation
      allow create: if isAuth() && request.auth.uid == userId;
      
      // Allow profile updates, but protect core identity fields unless finalizing role
      allow update: if isAuth() && request.auth.uid == userId && (
        // Case 1: Finalizing role from unassigned to owner
        (resource.data.role == 'unassigned' && request.resource.data.role == 'owner') ||
        // Case 2: Standard updates (e.g. name, avatar) - protect core fields
        (!request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'permissions', 'ownerId', 'guestId', 'staffId', 'subscription', 'wallet', 'billingConfig', 'activeTenancies', 'activeStaffProfiles', 'lastActiveContext']))
      );

      // ─── Wallet Transactions (read-only for owner, write via admin SDK) ─────
      match /wallet_transactions/{txnId} {
        allow read: if isAuth() && request.auth.uid == userId;
        // Writes are server-side only (admin SDK) for billing integrity
        allow write: if false;
      }

      // ─── Tenant Count Snapshots (read-only for owner, write via admin SDK) ──
      match /tenant_count_snapshots/{snapshotId} {
        allow read: if isAuth() && request.auth.uid == userId;
        allow write: if false;
      }

      // ─── Monthly Invoices (read-only for owner) ────────────────────────────
      match /monthly_invoices/{invoiceId} {
        allow read: if isAuth() && request.auth.uid == userId;
        allow write: if false;
      }

      // ─── Leads (CRM pipeline) ─────────────────────────────────────────────
      // Owners have full CRUD on their own leads.
      // Staff members belonging to this owner can read and create leads.
      match /leads/{leadId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
        // Staff under this owner can view and add leads
        allow read, create: if isAuth() && request.auth.token.ownerId == userId;
      }

      // ─── Community Posts (notices, events, marketplace) ───────────────────
      match /community_posts/{postId} {
        allow read: if isAuth() && (request.auth.uid == userId || request.auth.token.ownerId == userId);
        allow create: if isAuth() && (request.auth.uid == userId || request.auth.token.ownerId == userId);
        allow update, delete: if isAuth() && (
          request.auth.uid == userId || 
          request.auth.token.role == 'staff' || 
          request.auth.token.role == 'manager' || 
          (request.auth.token.ownerId == userId && (
            resource.data.authorId == request.auth.uid || 
            resource.data.authorId == request.auth.token.guestId
          ))
        );
      }

      // ─── Meter Readings (utility tracking) ────────────────────────────────
      match /meter_readings/{readingId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
        allow read, write: if isAuth() && request.auth.token.ownerId == userId;
      }

      // ─── Staff Advances ───────────────────────────────────────────────────
      match /staff_advances/{advanceId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
        allow read, write: if isAuth() && request.auth.token.ownerId == userId;
      }

      // ─── Staff Payrolls ───────────────────────────────────────────────────
      match /staff_payrolls/{payrollId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
        allow read, write: if isAuth() && request.auth.token.ownerId == userId;
      }

      // ─── Refund Records ───────────────────────────────────────────────────
      match /refund_records/{refundId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
        allow read, write: if isAuth() && request.auth.token.ownerId == userId;
      }

      // ─── Guests (subcollection alias used by utility/refund actions) ──────
      match /guests/{guestId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
        allow read, write: if isAuth() && request.auth.token.ownerId == userId;
      }
    }

    // ─── Invites ──────────────────────────────────────────────────────────────
    match /invites/{email} {
      allow read, delete: if isAuth() && request.auth.token.email == email;
    }

    // ─── Properties (PGs) ─────────────────────────────────────────────────────
    // For LIST queries (where ownerId == uid): allow any authenticated user.
    // The app's query always filters by ownerId so only own records come back.
    // For individual document reads, verify ownerId or staff token.
    match /pgs/{pgId} {
      allow list: if isAuth() && (
        request.query.limit <= 100 && (
          request.query.filters.ownerId == request.auth.uid ||
          request.auth.token.ownerId != null // Only allow listing if they have an owner context
        )
      );
      allow get:  if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        isStaff(pgId)
      );
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        isStaff(pgId)
      );
    }

    // ─── Guests ───────────────────────────────────────────────────────────────
    match /guests/{guestId} {
      allow list: if isAuth() && (
        request.query.limit <= 500 && (
          request.query.filters.ownerId == request.auth.uid ||
          request.auth.token.ownerId != null
        )
      );
      allow get:  if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        (isStaff(resource.data.pgId) && (hasPermission('guests', 'view') || request.auth.token.permissions.guests.view == true))
      );
      allow create: if isAuth() && (
        request.resource.data.ownerId == request.auth.uid ||
        (isStaff(request.resource.data.pgId) && (hasPermission('guests', 'add') || request.auth.token.permissions.guests.add == true))
      ) && request.resource.data.name is string
        && request.resource.data.pgId is string
        && request.resource.data.email is string;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        (isStaff(resource.data.pgId) && (hasPermission('guests', 'edit') || request.auth.token.permissions.guests.edit == true))
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        (isStaff(resource.data.pgId) && (hasPermission('guests', 'delete') || request.auth.token.permissions.guests.delete == true))
      );
    }

    // ─── Complaints ───────────────────────────────────────────────────────────
    match /complaints/{complaintId} {
      allow list: if isAuth() && (
        request.query.filters.ownerId == request.auth.uid ||
        request.auth.token.ownerId != null
      );
      allow get:  if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        (isStaff(resource.data.pgId) && (hasPermission('complaints', 'view') || request.auth.token.permissions.complaints.view == true))
      );
      allow create, update, delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        (isStaff(resource.data.pgId) && (hasPermission('complaints', 'edit') || request.auth.token.permissions.complaints.edit == true))
      );
    }

    // ─── Expenses / Finances ─────────────────────────────────────────────────
    match /expenses/{expenseId} {
      allow list: if isAuth() && (
        request.query.filters.ownerId == request.auth.uid ||
        request.auth.token.ownerId != null
      );
      allow get:  if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        (isStaff(resource.data.pgId) && (hasPermission('finances', 'view') || request.auth.token.permissions.finances.view == true))
      );
      allow create: if isAuth() && (
        request.resource.data.ownerId == request.auth.uid ||
        (isStaff(request.resource.data.pgId) && (hasPermission('finances', 'add') || request.auth.token.permissions.finances.add == true))
      ) && request.resource.data.amount is number
        && request.resource.data.pgId is string;
      allow update, delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        (isStaff(resource.data.pgId) && (hasPermission('finances', 'edit') || request.auth.token.permissions.finances.edit == true || request.auth.token.permissions.finances.add == true))
      );
    }

    // ─── Staff ────────────────────────────────────────────────────────────────
    match /staff/{staffId} {
      allow list: if isAuth() && (
        request.query.filters.ownerId == request.auth.uid ||
        request.auth.token.ownerId != null
      );
      allow get:  if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        (isStaff(resource.data.pgId) && (hasPermission('staff', 'view') || request.auth.token.permissions.staff.view == true))
      );
      allow create: if isAuth() && (
        request.resource.data.ownerId == request.auth.uid ||
        (isStaff(request.resource.data.pgId) && (hasPermission('staff', 'add') || request.auth.token.permissions.staff.add == true))
      ) && request.resource.data.name is string
        && request.resource.data.pgId is string;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        (isStaff(resource.data.pgId) && (hasPermission('staff', 'edit') || request.auth.token.permissions.staff.edit == true))
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        (isStaff(resource.data.pgId) && (hasPermission('staff', 'delete') || request.auth.token.permissions.staff.delete == true))
      );
    }

    // ─── Charge Templates ────────────────────────────────────────────────────
    match /chargeTemplates/{templateId} {
      allow list: if isAuth() && (
        request.query.filters.ownerId == request.auth.uid ||
        request.auth.token.ownerId != null
      );
      allow get, update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
    }

    // ─── Owner data (permissions, etc.) ──────────────────────────────────────
    match /users_data/{ownerId}/{collectionName}/{docId} {
      // Owners have full access to their own data
      allow read, write: if isAuth() && request.auth.uid == ownerId;

      // Staff access is scoped to their assigned properties
      allow read, write: if isAuth() && request.auth.token.ownerId == ownerId && (
        (collectionName == 'notifications' && (
          resource.data.targetId == request.auth.uid || 
          request.auth.token.pgs.hasAny([resource.data.targetId])
        )) ||
        collectionName == 'chargeTemplates' || 
        (collectionName == 'pgs' && isStaff(docId)) ||
        (resource.data.pgId != null && isStaff(resource.data.pgId)) ||
        (request.resource.data.pgId != null && isStaff(request.resource.data.pgId)) ||
        (collectionName == 'staff' && (
          (resource.data.pgIds != null && resource.data.pgIds.hasAny(request.auth.token.pgs)) ||
          (request.resource.data.pgIds != null && request.resource.data.pgIds.hasAny(request.auth.token.pgs))
        ))
      );

      // Support for collection-level listing (Staff)
      allow list: if isAuth() && request.auth.token.ownerId == ownerId && (
        (collectionName == 'notifications' && request.query.filters.targetId != null && 
          request.auth.token.pgs.concat([request.auth.uid]).hasAll(request.query.filters.targetId)) ||
        collectionName == 'chargeTemplates' ||
        (collectionName == 'pgs' && request.query.filters.__name__ != null && request.auth.token.pgs.hasAll(request.query.filters.__name__)) ||
        (request.query.filters.pgId != null && request.auth.token.pgs.hasAll(request.query.filters.pgId)) ||
        (collectionName == 'staff' && request.query.filters.pgIds != null && request.auth.token.pgs.hasAll(request.query.filters.pgIds))
      );
    }

    // ─── Default: deny all ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}